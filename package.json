{
  "name": "app",
  "version": "1.0.1",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:start": "electron .",
    "dev": "concurrently -k -n ANGULAR,ELECTRON -c blue,green \"ng serve\" \"npm:electron:dev\"",
    "electron:dev": "npm run electron:build && wait-on tcp:4200 && cross-env NODE_ENV=development electron .",
    "predist": "npm version patch --no-git-tag-version",
    "dist": "npm run build && npm run electron:build && electron-builder"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.greengrow.app",
    "productName": "GreenGrow",
    "files": [
      "dist-electron/**/*",
      "dist/app/browser/**/*",
      "build-resources/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico"
    }
  }
}
